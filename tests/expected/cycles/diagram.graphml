          <y:Geometry x="0" y="320" width="80" height="40"/>
          <y:Fill color="#E8F0FE" transparent="false"/>
          <y:BorderStyle color="#47699B" type="line" width="1.0"/>
          <y:NodeLabel modelName="internal" modelPosition="c" xml:space="preserve">tools</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <edge id="e0" source="n0" target="n0">
      <data key="weight">19</data>
      <data key="kind">production</data>
      <data key="cycle_group">1</data>
      <data key="eg">
        <y:PolyLineEdge>
          <y:LineStyle color="#E41A1C" type="line" width="3.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel>19</y:EdgeLabel>
          <y:BendStyle smoothed="false"/>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e1" source="n0" target="n0">
      <data key="weight">6</data>
      <data key="kind">test</data>
      <data key="cycle_group">1</data>
