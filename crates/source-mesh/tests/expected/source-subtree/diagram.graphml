          <y:BorderStyle color="#47699B" type="line" width="1.0"/>
          <y:NodeLabel modelName="internal" modelPosition="c" xml:space="preserve">.</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
