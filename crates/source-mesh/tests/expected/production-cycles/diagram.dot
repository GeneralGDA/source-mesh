  n5[label="crates/source-mesh/tests" shape=box]
  n0 -> n1 [label="3"]
  n1 -> n1 [label="22" color="#E41A1C" penwidth=3.0 cycle_group=1]
  n1 -> n2 [label="2"]
  n1 -> n3 [label="8"]
  n2 -> n2 [label="18" color="#377EB8" penwidth=3.0 cycle_group=2]
  n2 -> n3 [label="13"]
  n3 -> n3 [label="5" color="#4DAF4A" penwidth=3.0 cycle_group=3]
  n4 -> n1 [label="3"]
  n4 -> n2 [label="1"]
}
